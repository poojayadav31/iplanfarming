# Server Configuration
PORT=5000

# Database Configuration
# These values match the Docker Compose PostgreSQL service in ../docker-compose.yml
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=iplanfarmhouse
POSTGRES_SCHEMA=public

# Optional explicit Prisma URLs. Leave commented unless you need to override the derived local URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/iplanfarmhouse?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/iplanfarmhouse?schema=public
PRISMA_RUNTIME_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/iplanfarmhouse?schema=public

# JWT Configuration
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=7d
